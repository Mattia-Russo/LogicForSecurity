Protocol: KeyLookUp_W5

Types:
    Agent A, P, B, idp;
    Number Na;
    Format f_keyreq, f_keyresp, f_keypair;

Knowledge:
    A:   A, P, B, idp, pk(idp), pwd(A);
    idp: A, P, B, idp, pk(idp), inv(pk(idp)), pk(P), pk(B)

Actions:
    # A requests the public keys of P and B from idp over TLS.
    # [A]*->*idp replaces the explicit pk(idp) encryption from W4.
    [A]  *->* idp: f_keyreq(A, P, B, Na)

    # idp returns a signed response binding agent names to public keys.
    # The signature is kept: it is a transferable certificate that A
    # can later verify without needing another TLS session.
    idp -> A: {f_keyresp(A, f_keypair(P, pk(P)), f_keypair(B, pk(B)), Na)}inv(pk(idp))

Goals:
    A authenticates idp on f_keyresp(A, f_keypair(P, pk(P)), f_keypair(B, pk(B)), Na)
