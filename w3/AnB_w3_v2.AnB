Protocol: PhotoPrint_W3

Types:
    Agent A, P, B, idp;
    Number Res, Authcode, SessionID, Nb, Ni, Np, Nc, Nd, PhotosA;
    Function pwd

Knowledge:
    A:   A, P, B, idp, pk(idp), pk(B), pk(P), pwd(A);
    idp: A, P, B, idp, pk(idp), inv(pk(idp)), pk(P), pk(B), pwd(A);
    P:   A, P, B, idp, pk(idp), pk(P), inv(pk(P)), pk(B);
    B:   A, P, B, idp, pk(idp), pk(B), inv(pk(B)), pk(P)

where B!=P

Actions:
    # Step 1: P -> B  (access request)
    # P requests access to A's resource Res at B on behalf of A.
    # Encrypted for B and signed by P so B can verify the sender.
    # Nd is a fresh nonce from P to allow B to bind subsequent messages.
    P -> B:   {{A, P, B, Res, Nd}inv(pk(P))}pk(B)

    # Step 2: B -> P  (session ID)
    # B acknowledges and issues a fresh SessionID for this flow.
    # Signed by B and encrypted for P; includes Nd to bind to step 1.
    B -> P:   {{A, P, B, Res, SessionID, Nd}inv(pk(B))}pk(P)

    # Step 3: P -> B  (session ID echo)
    # P echoes the SessionID back to B, proving it received and accepted it.
    # Signed by P and encrypted for B.
    P -> B:   {{A, P, B, Res, SessionID, Nd}inv(pk(P))}pk(B)

    # Step 4: B -> idp  (auth request)
    # B redirects the flow to the identity provider, asking it to
    # authenticate A and obtain her consent to share Res with P.
    # Nb is a fresh nonce from B for replay protection.
    B -> idp: {{A, P, B, Res, Nb, SessionID}inv(pk(B))}pk(idp)

    # Step 5: idp -> A  (password challenge)
    # idp forwards the request context to A and asks for her password.
    # Signed by idp (no outer encryption needed — sent to A who knows pk(idp)).
    # Ni is a fresh nonce from idp to bind A's response to this challenge.
    idp -> A: {A, P, B, Res, Nb, SessionID, Ni}inv(pk(idp))

    # Step 6: A -> idp  (password response)
    # A submits her password together with all session context.
    # Encrypted for idp — pwd(A) must stay confidential.
    # Uses idp's public key (not pwd as encryption key, as required).
    A -> idp: {A, P, B, Res, pwd(A), Nb, SessionID, Ni}pk(idp)

    # Step 7: idp -> B  (consent token)
    # idp confirms A's identity and consent.
    # Signed by idp so B can verify; encrypted for B.
    idp -> B: {{A, B, P, Res, Nb, SessionID}inv(pk(idp))}pk(B)

    # Step 8: B -> P  (auth code)
    # B issues a fresh auth code Authcode to P, redeemable for Res.
    # Np is a fresh nonce from B binding the auth code to this exchange.
    B -> P:   {{A, B, P, Res, Authcode, SessionID, Np}inv(pk(B))}pk(P)

    # Step 9: P -> B  (resource request)
    # P presents the auth code to B to claim the photos.
    # Nc is a fresh nonce from P so B can bind its response.
    P -> B:   {{A, P, B, Res, Authcode, SessionID, Np, Nc}inv(pk(P))}pk(B)

    # Step 10: B -> P  (photos delivery)
    # B returns the requested photos, encrypted for P and signed by B.
    # Nc is included to bind the response to P's specific request.
    B -> P:   {{A, P, B, Res, PhotosA, SessionID, Authcode, Nc}inv(pk(B))}pk(P)


Goals:
    PhotosA secret between B, P;
    pwd(A) secret between A, idp;

    B authenticates P on A, P, B, Res, Nd
    P authenticates B on A, P, B, Res, SessionID, Nd
    B authenticates P on A, P, B, Res, SessionID, Nd
    idp authenticates A on A, P, B, Res, pwd(A), Nb, SessionID, Ni
    B authenticates idp on A, B, P, Res, Nb, SessionID
    P authenticates B on A, B, P, Res, Authcode, SessionID, Np
    B authenticates P on A, P, B, Res, Authcode, SessionID, Np, Nc
    P authenticates B on A, P, B, Res, PhotosA, SessionID, Authcode, Nc