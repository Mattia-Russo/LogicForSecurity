Protocol: PhotoPrint_W3

# Week 3 version of the PhotoPrint protocol.
#
# This version introduces the full OAuth-like flow that is carried forward
# into w4 and w5. It uses raw concatenations (no formats yet — those come
# in w4) and already contains all 10 steps.
#
# Key design decisions vs. the earlier sketch:
#   - A does NOT start the flow; P initiates by sending an access request to B.
#   - B redirects A (via idp) to obtain consent.
#   - A authenticates to idp with pwd(A) — not used as an encryption key.
#   - idp issues a signed consent token back to B.
#   - B produces an auth code for P.
#   - P redeems the auth code to retrieve PhotosA from B.
#
# Nonces / fresh values (not in initial knowledge):
#   Nd       : nonce from P, binds the initial access request
#   SessionID: fresh session identifier generated by B
#   Nb       : nonce from B, included in the auth request to idp
#   Ni       : nonce from idp, binds the password challenge to A
#   Authcode : fresh auth code generated by B for P
#   Np       : nonce from B, included in the auth-code message to P
#   Nc       : nonce from P, included in the resource request to B
#   PhotosA  : the photos resource (modelled as a Number/fresh value)
#
# pwd(A) is A's shared secret with idp. It is used as an authenticator
# (sent encrypted to idp), never as a symmetric key.

Types:
    Agent A, P, B, idp;
    Number Res, Authcode, SessionID, Nb, Ni, Np, Nc, Nd, PhotosA;
    Function pwd

Knowledge:
    A:   A, P, B, idp, pk(idp), pk(B), pk(P), pwd(A);
    idp: A, P, B, idp, pk(idp), inv(pk(idp)), pk(P), pk(B), pwd(A);
    P:   A, P, B, idp, pk(idp), pk(P), inv(pk(P)), pk(B);
    B:   A, P, B, idp, pk(idp), pk(B), inv(pk(B)), pk(P)

where B!=P

Actions:
    # Step 1: P -> B  (access request)
    # P requests access to A's resource Res at B on behalf of A.
    # Encrypted for B and signed by P so B can verify the sender.
    # Nd is a fresh nonce from P to allow B to bind subsequent messages.
    P -> B:   {{A, P, B, Res, Nd}inv(pk(P))}pk(B)

    # Step 2: B -> P  (session ID)
    # B acknowledges and issues a fresh SessionID for this flow.
    # Signed by B and encrypted for P; includes Nd to bind to step 1.
    B -> P:   {{A, P, B, Res, SessionID, Nd}inv(pk(B))}pk(P)

    # Step 3: P -> B  (session ID echo)
    # P echoes the SessionID back to B, proving it received and accepted it.
    # Signed by P and encrypted for B.
    P -> B:   {{A, P, B, Res, SessionID, Nd}inv(pk(P))}pk(B)

    # Step 4: B -> idp  (auth request)
    # B redirects the flow to the identity provider, asking it to
    # authenticate A and obtain her consent to share Res with P.
    # Nb is a fresh nonce from B for replay protection.
    B -> idp: {{A, P, B, Res, Nb, SessionID}inv(pk(B))}pk(idp)

    # Step 5: idp -> A  (password challenge)
    # idp forwards the request context to A and asks for her password.
    # Signed by idp (no outer encryption needed — sent to A who knows pk(idp)).
    # Ni is a fresh nonce from idp to bind A's response to this challenge.
    idp -> A: {A, P, B, Res, Nb, SessionID, Ni}inv(pk(idp))

    # Step 6: A -> idp  (password response)
    # A submits her password together with all session context.
    # Encrypted for idp — pwd(A) must stay confidential.
    # Uses idp's public key (not pwd as encryption key, as required).
    A -> idp: {A, P, B, Res, pwd(A), Nb, SessionID, Ni}pk(idp)

    # Step 7: idp -> B  (consent token)
    # idp confirms A's identity and consent.
    # Signed by idp so B can verify; encrypted for B.
    idp -> B: {{A, B, P, Res, Nb, SessionID}inv(pk(idp))}pk(B)

    # Step 8: B -> P  (auth code)
    # B issues a fresh auth code Authcode to P, redeemable for Res.
    # Np is a fresh nonce from B binding the auth code to this exchange.
    B -> P:   {{A, B, P, Res, Authcode, SessionID, Np}inv(pk(B))}pk(P)

    # Step 9: P -> B  (resource request)
    # P presents the auth code to B to claim the photos.
    # Nc is a fresh nonce from P so B can bind its response.
    P -> B:   {{A, P, B, Res, Authcode, SessionID, Np, Nc}inv(pk(P))}pk(B)

    # Step 10: B -> P  (photos delivery)
    # B returns the requested photos, encrypted for P and signed by B.
    # Nc is included to bind the response to P's specific request.
    B -> P:   {{A, P, B, Res, PhotosA, SessionID, Authcode, Nc}inv(pk(B))}pk(P)


Goals:
    PhotosA secret between B, P;
    pwd(A) secret between A, idp;

    B authenticates P on A, P, B, Res, Nd
    P authenticates B on A, P, B, Res, SessionID, Nd
    B authenticates P on A, P, B, Res, SessionID, Nd
    idp authenticates A on A, P, B, Res, pwd(A), Nb, SessionID, Ni
    B authenticates idp on A, B, P, Res, Nb, SessionID
    P authenticates B on A, B, P, Res, Authcode, SessionID, Np
    B authenticates P on A, P, B, Res, Authcode, SessionID, Np, Nc
    P authenticates B on A, P, B, Res, PhotosA, SessionID, Authcode, Nc


# =============================================================================
# Special Task – Week 3: Lazy Intruder — Executability of Role P
# =============================================================================
#
# We instantiate P = i (intruder plays role P) and keep A = a, B = b,
# idp = idp as honest agents. We show that the intruder can send every
# outgoing message of role P having only seen the preceding incoming messages,
# following exactly the lazy intruder method from the lecture.
#
# Role P's steps in the 10-step protocol:
#
#   OUT step 1:  {{a, i, b, Res, Nd}inv(pk(i))}pk(b)
#   IN  step 2:  {{a, i, b, Res, SessionID, Nd}inv(pk(b))}pk(i)
#   OUT step 3:  {{a, i, b, Res, SessionID, Nd}inv(pk(i))}pk(b)
#   IN  step 8:  {{a, b, i, Res, Authcode, SessionID, Np}inv(pk(b))}pk(i)
#   OUT step 9:  {{a, i, b, Res, Authcode, SessionID, Np, Nc}inv(pk(i))}pk(b)
#   IN  step 10: {{a, i, b, Res, PhotosA, SessionID, Authcode, Nc}inv(pk(b))}pk(i)
#
# --- Intruder's initial knowledge ---
#
#   M0 = { a, b, i, idp, Res, pk(a), pk(b), pk(i), inv(pk(i)), pk(idp) }
#   (Role P's initial knowledge with P=i, A=a, B=b.)
#
# --- Honest strands running in parallel ---
#
#   Role B (with A=a, P=i, B=b):
#     IN  step 1:  receives from i  →  i sends step-1 message
#     OUT step 2:  sends to i       →  i receives step-2 message  [msg_in2]
#     IN  step 3:  receives from i  →  i sends step-3 message
#     IN  step 4:  sends to idp (internal, not visible to i as P)
#     IN  step 7:  receives from idp (internal)
#     OUT step 8:  sends to i       →  i receives step-8 message  [msg_in8]
#     IN  step 9:  receives from i  →  i sends step-9 message
#     OUT step 10: sends to i       →  i receives step-10 message [msg_in10]
#
#   (Steps 4–7 involve only b, a, and idp; the intruder as P does not
#    directly participate but the honest b strand completes them.)
#
# Short-hand notation used below:
#   sn  = SessionID value generated by b in step 2
#   ac  = Authcode   value generated by b in step 8
#   np  = Np         value generated by b in step 8
#
# --- Step-by-step execution ---
#
# [OUT step 1]  i must send: {{a, i, b, Res, Nd}inv(pk(i))}pk(b)
#
#   i chooses Nd freshly (its own nonce).
#
#   Check M0 ⊢ {{a, i, b, Res, Nd}inv(pk(i))}pk(b) :
#     EncAsym: need pk(b) ∈ M0                   — Yes. [Axiom]
#              need {a, i, b, Res, Nd}inv(pk(i))
#       Sign:  need inv(pk(i)) ∈ M0              — Yes. [Axiom]
#              need a, i, b, Res, Nd ∈ M0
#                a, i, b, Res ∈ M0               — Yes. [Axiom×4]
#                Nd chosen fresh by i             — Yes. [Fresh]
#   => M0 ⊢ {{a, i, b, Res, Nd}inv(pk(i))}pk(b)  [OK]
#
#   M1 = M0 ∪ { Nd }
#
# [IN step 2]  i receives: msg_in2 = {{a, i, b, Res, sn, Nd}inv(pk(b))}pk(i)
#
#   M2 = M1 ∪ { msg_in2 }
#
#   Analysis – DecAsym on msg_in2:
#     Need inv(pk(i)) — M2 ⊢c inv(pk(i))? Yes (∈ M0). [Axiom]
#     => Learned: {a, i, b, Res, sn, Nd}inv(pk(b))
#   Analysis – OpenSig on {a, i, b, Res, sn, Nd}inv(pk(b)):
#     OpenSig: M ⊢ {m}inv(k) => M ⊢ m  (no key required)
#     => Learned: a, i, b, Res, sn, Nd  (sn is new)
#
#   M2* = M2 ∪ { {a,i,b,Res,sn,Nd}inv(pk(b)), sn }
#
# [OUT step 3]  i must send: {{a, i, b, Res, sn, Nd}inv(pk(i))}pk(b)
#
#   Check M2* ⊢ {{a, i, b, Res, sn, Nd}inv(pk(i))}pk(b) :
#     EncAsym: need pk(b) ∈ M0                   — Yes. [Axiom]
#              need {a, i, b, Res, sn, Nd}inv(pk(i))
#       Sign:  need inv(pk(i)) ∈ M0              — Yes. [Axiom]
#              need a, i, b, Res, sn, Nd
#                ∈ M2*                            — Yes. [Axiom×6]
#   => M2* ⊢ {{a, i, b, Res, sn, Nd}inv(pk(i))}pk(b)  [OK]
#
#   (No new terms added; M3 = M2*)
#
# [IN step 8]  i receives: msg_in8 = {{a, b, i, Res, ac, sn, np}inv(pk(b))}pk(i)
#   (Arrives after honest b completes steps 4–7 internally.)
#
#   M4 = M3 ∪ { msg_in8 }
#
#   Analysis – DecAsym on msg_in8:
#     Need inv(pk(i)) — Yes (∈ M0). [Axiom]
#     => Learned: {a, b, i, Res, ac, sn, np}inv(pk(b))
#   Analysis – OpenSig:
#     => Learned: a, b, i, Res, ac, sn, np  (ac, np are new)
#
#   M4* = M4 ∪ { {a,b,i,Res,ac,sn,np}inv(pk(b)), ac, np }
#
# [OUT step 9]  i must send: {{a, i, b, Res, ac, sn, np, Nc}inv(pk(i))}pk(b)
#
#   i chooses Nc freshly (its own nonce).
#
#   Check M4* ⊢ {{a, i, b, Res, ac, sn, np, Nc}inv(pk(i))}pk(b) :
#     EncAsym: need pk(b) ∈ M0                   — Yes. [Axiom]
#              need {a, i, b, Res, ac, sn, np, Nc}inv(pk(i))
#       Sign:  need inv(pk(i)) ∈ M0              — Yes. [Axiom]
#              need a, i, b, Res, ac, sn, np ∈ M4* — Yes. [Axiom×7]
#              need Nc chosen fresh by i          — Yes. [Fresh]
#   => M4* ⊢ {{a, i, b, Res, ac, sn, np, Nc}inv(pk(i))}pk(b)  [OK]
#
#   M5 = M4* ∪ { Nc }
#
# [IN step 10]  i receives: msg_in10 = {{a, i, b, Res, photos_a, sn, ac, Nc}inv(pk(b))}pk(i)
#
#   M6 = M5 ∪ { msg_in10 }
#
#   Analysis – DecAsym on msg_in10:
#     Need inv(pk(i)) — Yes (∈ M0). [Axiom]
#     => Learned: {a, i, b, Res, photos_a, sn, ac, Nc}inv(pk(b))
#   Analysis – OpenSig:
#     => Learned: a, i, b, Res, photos_a, sn, ac, Nc  (photos_a is new)
#
#   M6* = M6 ∪ { photos_a }
#   => M6* ⊢ photos_a  [Axiom]
#
# --- Conclusion ---
#
#   The intruder successfully executes every step of role P:
#     OUT step 1:  i generates Nd freshly; composes the signed+encrypted message. [Fresh+Compose]
#     IN  step 2:  i decrypts with inv(pk(i)) and opens the signature.            [DecAsym+OpenSig]
#     OUT step 3:  i re-signs the session ID with inv(pk(i)).                      [Axiom+Compose]
#     IN  step 8:  i decrypts and opens signature on the auth code.               [DecAsym+OpenSig]
#     OUT step 9:  i generates Nc freshly; reuses ac, sn, np from M4*.            [Fresh+Compose]
#     IN  step 10: i decrypts and obtains photos_a.                               [DecAsym+OpenSig]
#
#   Role P is executable by the intruder.
#   The intruder learns PhotosA (photos_a) at the end of the execution —
#   consistent with the fact that the protocol does not protect PhotosA
#   against a malicious P (who is an authorized recipient of the photos).