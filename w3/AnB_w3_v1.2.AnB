Protocol: PhotoPrint_W3

Types:
    Agent A, P, B, idp;
    Number Grant, Na, Np, PhotosA;
    Function pwd; # function because each agent could have its own password (intruder included)

Knowledge:
    A:   A, P, B, idp, pk(idp), pwd(A), pk(B), pk(P);
    idp: A, P, B, idp, pk(idp), inv(pk(idp)), pk(P), pk(B), pwd(A);
    P:   A, P, B, idp, pk(idp), pk(P), inv(pk(P)), pk(B);
    B:   A, P, B, idp, pk(idp), pk(B), inv(pk(B)), pk(P)

Actions:
    A   -> idp: {A, P, B, pwd(A), Na}(pk(idp))
    idp -> A:   {A, P, B, Grant, Na}(inv(pk(idp)))
    A   -> P:   {{A, P, B, Grant, Na}(inv(pk(idp)))}(pk(P))
    P   -> B:   {{{A, P, B, Grant, Na}(inv(pk(idp))), Np}(pk(B)), Np}(inv(pk(P)))
    B   -> P:   {PhotosA, Np}(pk(P))

Goals:
    PhotosA secret between B, P;
    Grant secret between A, idp, P, B; #this is hard to achive: idp doesn't have a secure key to use to encrypt the response to A