Protocol: KeyLookUp_W4

Types:
    Agent A, P, B, idp;
    Number Na;
    Format f_keyreq, f_keyresp, f_keypair;

Knowledge:
    A:   A, P, B, idp, pk(idp), pwd(A);
    idp: A, P, B, idp, pk(idp), inv(pk(idp)), pk(P), pk(B)

Actions:
    # A requests public keys of P and B from idp, using a fresh nonce Na
    # for replay protection. Encrypted so the request is confidential.
    A   -> idp: {f_keyreq(A, P, B, Na)}pk(idp)

    # idp returns the public keys of P and B, signed and including Na,
    # so A can verify the response is fresh and from idp.
    idp -> A:   {f_keyresp(A, f_keypair(P, pk(P)), f_keypair(B, pk(B)), Na)}inv(pk(idp))

Goals:
    A authenticates idp on f_keyresp(A, f_keypair(P, pk(P)), f_keypair(B, pk(B)), Na)