Protocol: KeyLookUp_W4

# Sub-protocol: A asks idp for the public keys of P and B.
# A only knows pk(idp) initially; idp signs the response so A can verify it.
# Na is freshly generated by A.
Types:
    Agent A, P, B, idp;
    Number Na;
    Format f_keyreq, f_keyresp, f_keypair;

Knowledge:
    A:   A, P, B, idp, pk(idp), pwd(A);
    idp: A, P, B, idp, pk(idp), inv(pk(idp)), pk(P), pk(B)

Actions:
    # A requests public keys of P and B from idp, using a fresh nonce Na
    # for replay protection. Encrypted so the request is confidential.
    A   -> idp: {f_keyreq(A, P, B, Na)}pk(idp)

    # idp returns the public keys of P and B, signed and including Na,
    # so A can verify the response is fresh and from idp.
    idp -> A:   {f_keyresp(A, f_keypair(P, pk(P)), f_keypair(B, pk(B)), Na)}inv(pk(idp))

Goals:
    A authenticates idp on f_keyresp(A, f_keypair(P, pk(P)), f_keypair(B, pk(B)), Na)


# =============================================================================
# Special Task (Week 4) — Type-Flaw Resistance: KeyLookUp_W4
# =============================================================================
#
# Step 1: Collect SMP (non-variable sub-message patterns, variables renamed
#         so distinct messages share no variables).
#
# Protocol messages:
#   msg1 = {f_keyreq(A1, P1, B1, na1)}pk(idp)
#   msg2 = {f_keyresp(A2, f_keypair(P2, pk(P2)), f_keypair(B2, pk(B2)), na2)}inv(pk(idp))
#
# Sub-message patterns (non-variable, after renaming):
#   s1  = {f_keyreq(A1,P1,B1,na1)}pk(idp)
#   s2  = f_keyreq(A1, P1, B1, na1)
#   s3  = pk(idp)                                          [constant key]
#   s4  = {f_keyresp(A2,f_keypair(P2,pk(P2)),f_keypair(B2,pk(B2)),na2)}inv(pk(idp))
#   s5  = f_keyresp(A2, f_keypair(P2,pk(P2)), f_keypair(B2,pk(B2)), na2)
#   s6  = f_keypair(P2, pk(P2))
#   s7  = f_keypair(B2, pk(B2))
#   s8  = pk(P2)
#   s9  = pk(B2)
#   s10 = inv(pk(idp))                                     [from {..}inv(pk(idp))]
#
# Step 2: Check all pairs of non-variable SMP messages for unifiability.
#
# The only pairs that could potentially unify must share the same
# top-level constructor:
#
#   {..}pk(idp) vs {..}inv(pk(idp)):
#     These use different encryption constructors (public-key vs sign).
#     Their outer symbols differ => cannot unify.
#
#   f_keyreq(..) vs f_keyresp(..):
#     Different format symbols (f_keyreq ≠ f_keyresp) => cannot unify.
#
#   f_keypair(P2,pk(P2)) vs f_keypair(B2,pk(B2)):
#     Same constructor f_keypair/2. Unifier: P2=B2, pk(P2)=pk(B2).
#     Both are of type f_keypair(Agent, PublicKey) => same type. OK.
#
#   pk(P2) vs pk(B2):
#     Same constructor pk/1. Unifier: P2=B2.
#     Both are of type PublicKey => same type. OK.
#
#   pk(idp) vs pk(P2): unifier P2=idp. Both PublicKey => same type. OK.
#   pk(idp) vs pk(B2): unifier B2=idp. Both PublicKey => same type. OK.
#
#   inv(pk(idp)) vs pk(..): different constructors => cannot unify.
#
# All unifiable pairs have the same type.
# => KeyLookUp_W4 is type-flaw resistant.
