Protocol: PhotoPrint_W4

# Week 4: formats replace all concatenations; protocol is type-flaw resistant.
# A no longer initially knows pk(P) or pk(B); she obtains them via the
# separate KeyLookUp_W4 sub-protocol (modeled by including them in A's
# knowledge here with the comment that they are obtained from idp).
#
# pwd(A)  : A's password, a shared secret with idp (Function).
# photos  : B's photo collection (Number, fresh per session).
# Grant   : fresh authorization token generated by idp (Number).
# Na      : fresh nonce generated by A, used for hello handshake AND auth (Number).
# Np      : fresh nonce generated by P, used for P-B hello handshake AND request (Number).
#
# All concatenations are replaced by typed format symbols to ensure
# type-flaw resistance (see special task below).
#
# Authentication chain:
#   A authenticates P  via hello handshake (P signs f_hello with inv(pk(P)))
#   P authenticates B  via hello handshake (B signs f_hello with inv(pk(B)))
#   A authenticates idp via idp's signature on the grant
#   P authenticates idp via idp's signature on the grant
#   B authenticates idp via idp's signature on the grant
#
# Man-in-the-middle protection:
#   Na binds A's hello with P to A's auth request to idp and the grant.
#   Np binds P's hello with B to P's resource request to B and the photos response.
#   This prevents the intruder from mixing sessions.

Types:
    Agent A, P, B, idp;
    Number Na, Np, Grant, photos;
    Function pwd;
    Format f_auth, f_grant, f_req, f_photos, f_hello;

Knowledge:
    A:   A, P, B, idp, pk(idp), pk(B), pk(P), pwd(A);
    idp: A, P, B, idp, pk(idp), inv(pk(idp)), pk(P), pk(B), pwd(A);
    P:   A, P, B, idp, pk(idp), pk(P), inv(pk(P)), pk(B);
    B:   A, P, B, idp, pk(idp), pk(B), inv(pk(B)), pk(P), photos

Actions:
    # A-P hello: A authenticates P
A -> P:   f_hello(A, P, Na)
P -> A:   {f_hello(A, P, Na)}inv(pk(P))

# A authenticates to idp
A -> idp: {f_auth(A, P, B, pwd(A), Na)}pk(idp)

# idp issues signed grant
idp -> A: {f_grant(A, P, B, Grant, Na)}inv(pk(idp))

# A forwards grant to P
A -> P:   {{f_grant(A, P, B, Grant, Na)}inv(pk(idp))}pk(P)

# P-B hello: P authenticates B
P -> B:   f_hello(P, B, Np)
B -> P:   {f_hello(P, B, Np)}inv(pk(B))

# P presents grant to B
P -> B:   {f_req({f_grant(A, P, B, Grant, Na)}inv(pk(idp)), Np)}inv(pk(P))

# B challenges P to prove identity (breaks P=B collapse)
B -> P:   {f_hello(P, B, Np)}pk(P)
P -> B:   {f_hello(P, B, Np)}inv(pk(P))

# B releases photos
B -> P:   {f_photos(photos, Np)}pk(P)

Goals:
    photos secret between B, P;
    pwd(A) secret between A, idp;
    A authenticates P on Na;
    P authenticates B on Np;
    A authenticates idp on Grant;
    P authenticates idp on Grant;
    B authenticates idp on Grant;
    P authenticates B on Np

# =============================================================================
# Special Task (Week 4) — Type-Flaw Resistance: PhotoPrint_W4
# =============================================================================
#
# Step 1: Collect all protocol messages and compute SMP by taking all
# sub-message patterns, adding inv(k) for every {m}k, and renaming
# variables so distinct messages share no variables.
#
# Protocol messages:
#   msg0a = f_hello(A, P, Na)
#   msg0b = {f_hello(A, P, Na)}inv(pk(P))
#   msg1  = {f_auth(A, P, B, pwd(A), Na)}pk(idp)
#   msg2  = {f_grant(A, P, B, Grant, Na)}inv(pk(idp))
#   msg3  = {{f_grant(A, P, B, Grant, Na)}inv(pk(idp))}pk(P)
#   msg4a = f_hello(P, B, Np)
#   msg4b = {f_hello(P, B, Np)}inv(pk(B))
#   msg5  = {f_req({f_grant(A, P, B, Grant, Na)}inv(pk(idp)), Np)}pk(B)
#   msg6  = {f_photos(photos, Np)}pk(P)
#
# SMP (non-variable elements, variables renamed per message occurrence):
#
#   From msg0a:
#   s1  = f_hello(A1, P1, na1)
#
#   From msg0b:
#   s2  = {f_hello(A2, P2, na2)}inv(pk(P2))
#   s3  = f_hello(A2, P2, na2)           [= s1 up to renaming]
#   s4  = pk(P2)                          [also: inv(pk(P2)) added]
#   s4' = inv(pk(P2))
#
#   From msg1:
#   s5  = {f_auth(A3, P3, B3, pwd(A3), na3)}pk(idp)
#   s6  = f_auth(A3, P3, B3, pwd(A3), na3)
#   s7  = pwd(A3)
#   s8  = pk(idp)                         [also: inv(pk(idp)) added]
#   s8' = inv(pk(idp))
#
#   From msg2:
#   s9  = {f_grant(A4, P4, B4, grant4, na4)}inv(pk(idp))
#   s10 = f_grant(A4, P4, B4, grant4, na4)
#
#   From msg3:
#   s11 = {{f_grant(A5,P5,B5,grant5,na5)}inv(pk(idp))}pk(P5)
#   s12 = {f_grant(A5,P5,B5,grant5,na5)}inv(pk(idp))  [= s9 up to renaming]
#   s13 = pk(P5)                          [= s4 up to renaming]
#
#   From msg4a:
#   s14 = f_hello(P6, B6, np6)            [= s1 up to renaming]
#
#   From msg4b:
#   s15 = {f_hello(P7, B7, np7)}inv(pk(B7))
#   s16 = f_hello(P7, B7, np7)            [= s1 up to renaming]
#   s17 = pk(B7)                          [also: inv(pk(B7)) added]
#   s17'= inv(pk(B7))
#
#   From msg5:
#   s18 = {f_req({f_grant(A8,P8,B8,grant8,na8)}inv(pk(idp)), np8)}pk(B8)
#   s19 = f_req({f_grant(A8,P8,B8,grant8,na8)}inv(pk(idp)), np8)
#   s20 = {f_grant(A8,P8,B8,grant8,na8)}inv(pk(idp))  [= s9 up to renaming]
#   s21 = pk(B8)                          [= s17 up to renaming]
#
#   From msg6:
#   s22 = {f_photos(photos, np9)}pk(P9)
#   s23 = f_photos(photos, np9)
#   s24 = pk(P9)                          [= s4 up to renaming]
#
# Step 2: Check all pairs of non-variable SMP messages for unifiability.
#
# --- Format symbols (all distinct constructors or arities) ---
#   f_hello/3 vs f_auth/5:   different arity => cannot unify.
#   f_hello/3 vs f_grant/5:  different arity => cannot unify.
#   f_hello/3 vs f_req/2:    different arity => cannot unify.
#   f_hello/3 vs f_photos/2: different arity => cannot unify.
#   f_auth/5  vs f_grant/5:  different symbol => cannot unify.
#   f_auth/5  vs f_req/2:    different arity => cannot unify.
#   f_auth/5  vs f_photos/2: different arity => cannot unify.
#   f_grant/5 vs f_req/2:    different arity => cannot unify.
#   f_grant/5 vs f_photos/2: different arity => cannot unify.
#   f_req/2   vs f_photos/2: different symbol => cannot unify.
#
# --- Signatures {..}inv(pk(..)) ---
#   s2  = {f_hello(..)}inv(pk(P2))
#   s9  = {f_grant(..)}inv(pk(idp))
#   s15 = {f_hello(..)}inv(pk(B7))
#
#   s2 vs s9:  f_hello(..) vs f_grant(..) => different format symbols => cannot unify.
#   s2 vs s15: both {f_hello(..)}inv(pk(.)): unify with P2=B7, same type. OK.
#   s9 vs s15: f_grant(..) vs f_hello(..)  => different format symbols => cannot unify.
#
# --- Asymmetric encryptions {..}pk(..) ---
#   s5  = {f_auth(..)}pk(idp)
#   s11 = {{f_grant(..)}inv(pk(idp))}pk(P5)
#   s18 = {f_req(..)}pk(B8)
#   s22 = {f_photos(..)}pk(P9)
#
#   s5  vs s11: f_auth(..) vs {f_grant(..)}inv(..) => different constructors => cannot unify.
#   s5  vs s18: f_auth(..) vs f_req(..)  => different format symbols => cannot unify.
#   s5  vs s22: f_auth(..) vs f_photos(..) => different format symbols => cannot unify.
#   s11 vs s18: {f_grant(..)}inv(..) vs f_req(..) => different constructors => cannot unify.
#   s11 vs s22: {f_grant(..)}inv(..) vs f_photos(..) => different constructors => cannot unify.
#   s18 vs s22: f_req(..) vs f_photos(..) => different format symbols => cannot unify.
#
# --- Public keys pk(..) ---
#   All pk(.) pairs unify with same-agent substitution => same type PublicKey. OK.
#
# --- Private keys inv(pk(..)) ---
#   All inv(pk(.)) pairs unify with same-agent substitution => same type PrivateKey. OK.
#
# All pairs of unifiable non-variable SMP messages have the same type.
# => PhotoPrint_W4 is type-flaw resistant.
