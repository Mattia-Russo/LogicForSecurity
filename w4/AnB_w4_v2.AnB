Protocol: PhotoPrint_W4

# Week 4: formats replace all concatenations; protocol is type-flaw resistant.
# A no longer initially knows pk(P) or pk(B); she obtains them via the
# separate KeyLookUp_W4 sub-protocol (modeled by including them in A's
# knowledge here with the comment that they are obtained from idp).
#
# pwd(A)    : A's password, A shared secret with idp (Function, not Number).
# photos : A's photo collection stored at B (Function, not Number).
# Grant     : fresh authorization token generated by idp.
# Na        : fresh nonce generated by A.
# Np        : fresh nonce generated by P.
#
# All concatenations are replaced by typed format symbols to ensure
# type-flaw resistance (see special task below).

Types:
    Agent A, P, B, idp;
    Number Na, Np, Grant, photos;
    Function pwd;
    Format f_auth, f_grant, f_req, f_preq, f_presp, f_photos, f_hello;

Knowledge:
    A:   A, P, B, idp, pk(idp), pk(B), pk(P), pwd(A);
    idp: A, P, B, idp, pk(idp), inv(pk(idp)), pk(P), pk(B), pwd(A);
    P:   A, P, B, idp, pk(idp), pk(P), inv(pk(P)), pk(B);
    B:   A, P, B, idp, pk(idp), pk(B), inv(pk(B)), pk(P), photos

Actions:

    A   -> P:   f_hello(A, P, Na)
    P   -> A:   {f_hello(A, P, Na)}inv(pk(P))

    # Step 1: A authenticates to idp using her password and A fresh nonce Na.
    # f_auth distinguishes this as an authentication request.
    A   -> idp: {f_auth(A, P, B, pwd(A), Na)}pk(idp)

    # Step 2: idp issues A signed Grant token, including Na for freshness.
    # f_grant distinguishes this as A Grant message.
    idp -> A:   {{f_grant(A, P, B, Grant, Na)}inv(pk(idp))}pk(P)

    # Step 3: A forwards the idp-signed Grant to P, encrypted for P.
    A   -> P:   {{f_grant(A, P, B, Grant, Na)}inv(pk(idp))}pk(P)

    # Step 4: P presents the Grant to B together with A fresh nonce Np.
    # f_req distinguishes this as A resource request from P to B.
    P   -> B:   {f_req({f_grant(A, P, B, Grant, Na)}inv(pk(idp)), Np)}pk(B)

    # Step 5: B verifies the Grant (checks idp's signature), then returns
    # photos encrypted for P, echoing Np to bind the response to P's request.
    # f_photos distinguishes this as A photo response.
    B   -> P:   {f_photos(photos, Np)}pk(P)

Goals:
    #Grant secret between idp, P, B;
    photos secret between B, P;
    pwd(A) secret between A, idp;
    P authenticates idp on Grant;
    B authenticates idp on Grant;
    P authenticates B on Np;
    A authenticates P on Na;


# =============================================================================
# Special Task (Week 4) — Type-Flaw Resistance: PhotoPrint_W4
# =============================================================================
#
# Step 1: Collect all protocol messages and compute SMP by taking all
# sub-message patterns, adding inv(k) for every {m}k, and renaming
# variables so distinct messages share no variables.
#
# Protocol messages:
#   msg1 = {f_auth(A,P,B,pwd(A),Na)}pk(idp)
#   msg2 = {f_grant(A,P,B,Grant,Na)}inv(pk(idp))
#   msg3 = {{f_grant(A,P,B,Grant,Na)}inv(pk(idp))}pk(P)
#   msg4 = {f_req({f_grant(A,P,B,Grant,Na)}inv(pk(idp)), Np)}pk(B)
#   msg5 = {f_photos(photos, Np)}pk(P)
#
# SMP (non-variable elements, variables renamed per message occurrence):
#
#   From msg1:
#   s1  = {f_auth(A1,P1,B1,pwd(A1),na1)}pk(idp)
#   s2  = f_auth(A1, P1, B1, pwd(A1), na1)
#   s3  = pwd(A1)
#   s4  = pk(idp)                                      [also: inv(pk(idp)) added]
#   s4' = inv(pk(idp))
#
#   From msg2:
#   s5  = {f_grant(A2,P2,B2,grant2,na2)}inv(pk(idp))
#   s6  = f_grant(A2, P2, B2, grant2, na2)
#
#   From msg3:
#   s7  = {{f_grant(A3,P3,B3,grant3,na3)}inv(pk(idp))}pk(P3)
#   s8  = {f_grant(A3,P3,B3,grant3,na3)}inv(pk(idp))   [= s5 up to renaming]
#   s9  = pk(P3)                                        [also: inv(pk(P3)) added]
#   s9' = inv(pk(P3))
#
#   From msg4:
#   s10 = {f_req({f_grant(A4,P4,B4,grant4,na4)}inv(pk(idp)), np4)}pk(B4)
#   s11 = f_req({f_grant(A4,P4,B4,grant4,na4)}inv(pk(idp)), np4)
#   s12 = {f_grant(A4,P4,B4,grant4,na4)}inv(pk(idp))   [= s5 up to renaming]
#   s13 = pk(B4)                                        [also: inv(pk(B4)) added]
#   s13'= inv(pk(B4))
#
#   From msg5:
#   s14 = {f_photos(photos(A5), np5)}pk(P5)
#   s15 = f_photos(photos(A5), np5)
#   s16 = photos(A5)
#   s17 = pk(P5)                                        [= s9 up to renaming]
#
# Step 2: Check all pairs of non-variable SMP messages for unifiability.
# We only need to check pairs with the same top-level constructor.
#
# --- Asymmetric encryptions {..}pk(..) ---
#   s1  = {f_auth(..)}pk(idp)
#   s7  = {{f_grant(..)}inv(pk(idp))}pk(P3)
#   s10 = {f_req(..)}pk(B4)
#   s14 = {f_photos(..)}pk(P5)
#
#   s1 vs s7:  inner terms f_auth(..) vs {f_grant(..)}inv(..) — different
#              top-level constructors (f_auth vs crypt) => cannot unify.
#   s1 vs s10: f_auth(..) vs f_req(..) — different format symbols => cannot unify.
#   s1 vs s14: f_auth(..) vs f_photos(..) — different format symbols => cannot unify.
#   s7 vs s10: {f_grant(..)}inv(pk(idp)) vs f_req(..) — different constructors => cannot unify.
#   s7 vs s14: {f_grant(..)}inv(pk(idp)) vs f_photos(..) — different constructors => cannot unify.
#   s10 vs s14: f_req(..) vs f_photos(..) — different format symbols => cannot unify.
#
# --- Signatures {..}inv(pk(idp)) ---
#   s5, s8, s12 are all of the form {f_grant(..)}inv(pk(idp)).
#   Any two of them unify with the same type (f_grant signature). OK.
#
# --- Format symbols ---
#   f_auth/5 vs f_grant/5: different symbols => cannot unify.
#   f_auth/5 vs f_req/2:   different arity => cannot unify.
#   f_auth/5 vs f_photos/2: different symbols and arity => cannot unify.
#   f_grant/5 vs f_req/2:  different arity => cannot unify.
#   f_grant/5 vs f_photos/2: different arity => cannot unify.
#   f_req/2 vs f_photos/2: different symbols => cannot unify.
#
# --- Public keys pk(..) ---
#   pk(idp) vs pk(P3): unifier P3=idp. Both type PublicKey => same type. OK.
#   pk(idp) vs pk(B4): unifier B4=idp. Both type PublicKey => same type. OK.
#   pk(idp) vs pk(P5): unifier P5=idp. Both type PublicKey => same type. OK.
#   pk(P3) vs pk(B4):  unifier P3=B4.  Both type PublicKey => same type. OK.
#   All pk(..) pairs are the same type.
#
# --- Private keys inv(pk(..)) ---
#   inv(pk(idp)) vs inv(pk(P3)): unifier P3=idp. Both PrivateKey => same type. OK.
#   inv(pk(idp)) vs inv(pk(B4)): unifier B4=idp. Both PrivateKey => same type. OK.
#   inv(pk(P3)) vs inv(pk(B4)):  unifier P3=B4.  Both PrivateKey => same type. OK.
#
# --- Functions pwd(..), photos(..) ---
#   pwd(A1) vs photos(A5): different function symbols => cannot unify.
#
# All pairs of unifiable non-variable SMP messages have the same type.
# => PhotoPrint_W4 is type-flaw resistant.
