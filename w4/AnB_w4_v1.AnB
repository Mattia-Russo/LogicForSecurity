Protocol: PhotoPrint

Types:
    Agent A, P, B, idp;
    Number Res, Authcode, SessionID, Nb, Ni, Np, Nc, Nd, PhotosA;
    Function pwd;
    Format f_accessreq, f_sessionid, f_authreq, f_pwdreq, f_pwd, f_consent, f_authcode, f_req, f_photos;
    
Knowledge:
    A:   A, P, B, idp, pk(idp), pk(B), pk(P), pwd(A, idp);
    idp: A, P, B, idp, pk(idp), inv(pk(idp)), pk(P), pk(B), pwd(A, idp);
    P:   A, P, B, idp, pk(idp), pk(P), inv(pk(P)), pk(B);
    B:   A, P, B, idp, pk(idp), pk(B), inv(pk(B)), pk(P)

where B!=P

Actions:
    P -> B: {{f_accessreq(A, P, B, Res, Nd)}inv(pk(P))}pk(B)

    B -> P: {{f_sessionid(A, P, B, Res, SessionID, Nd)}inv(pk(B))}pk(P)

    P -> B: {{f_sessionid(A, P, B, Res, SessionID, Nd)}inv(pk(P))}pk(B)

    B -> idp: {{f_authreq(A, P, B, Res, Nb, SessionID)}inv(pk(B))}pk(idp)

    idp -> A: {f_pwdreq(A, P, B, Res, Nb, SessionID, Ni)}inv(pk(idp))

    A -> idp: {f_pwd(A, P, B, Res, pwd(A, idp), Nb, SessionID, Ni)}pk(idp)

    idp -> B: {{f_consent(A, B, P, Res, Nb, SessionID)}inv(pk(idp))}pk(B)

    B -> P: {{f_authcode(A, B, P, Res, Authcode, SessionID, Np)}inv(pk(B))}pk(P)

    P -> B: {{f_req(A, P, B, Res, Authcode, SessionID, Np, Nc)}inv(pk(P))}pk(B)

    B -> P: {{f_photos(A, P, B, Res, PhotosA, SessionID, Authcode, Nc)}inv(pk(B))}pk(P)


Goals:
    PhotosA secret between B, P;
    pwd(A, idp) secret between A, idp;
    
    B authenticates P on f_accessreq(A, P, B, Res, Nd)
    P authenticates B on f_sessionid(A, P, B, Res, SessionID, Nd)
    B authenticates P on f_sessionid(A, P, B, Res, SessionID, Nd)
    idp authenticates A on f_pwd(A, P, B, Res, pwd(A, idp), Nb, SessionID, Ni)
    B authenticates idp on f_consent(A, B, P, Res, Nb, SessionID)
    P authenticates B on f_authcode(A, B, P, Res, Authcode, SessionID, Np)
    B authenticates P on f_req(A, P, B, Res, Authcode, SessionID, Np, Nc)
    P authenticates B on f_photos(A, P, B, Res, PhotosA, SessionID, Authcode, Nc)
